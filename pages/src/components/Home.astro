---
import type zh from '../i18n/zh';

interface Props {
  t: typeof zh;
}
const { t } = Astro.props;
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={t.locale === 'en' ? '/en/' : '/'}>
      <img src="/favicon.svg" alt="soulink" width="24" height="24" />
      <span>soulink</span>
    </a>
    <nav>
      <a href="#features">{t.nav.features}</a>
      <a href="#quickstart">{t.nav.quickstart}</a>
      <a href="#tiers">{t.nav.tiers}</a>
      <a href="https://github.com/soulink9/soulink" target="_blank" rel="noopener">{t.nav.github}</a>
      <button class="theme-toggle" data-theme-toggle type="button" aria-label={t.nav.theme} title={t.nav.theme}>
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="lang-switch" href={t.altPath}>{t.altLabel}</a>
    </nav>
  </div>
</header>

<main>
  <section class="hero">
    <div class="container">
      <p class="badge">{t.hero.badge}</p>
      <h1>{t.hero.titleA}<br /><span class="grad">{t.hero.titleB}</span></h1>
      <p class="sub">{t.hero.sub}</p>
      <div class="cta">
        <a class="btn primary" href="#quickstart">{t.hero.ctaStart}</a>
        <a class="btn" href="https://github.com/soulink9/soulink" target="_blank" rel="noopener">{t.hero.ctaGithub}</a>
      </div>
      <div class="os-tabs hero-tabs">
        <button class="os-tab" data-os="macos" type="button">macOS</button>
        <button class="os-tab" data-os="linux" type="button">Linux</button>
        <button class="os-tab" data-os="windows" type="button">Windows</button>
      </div>
      <div class="term">
        <div class="term-bar"><i></i><i></i><i></i></div>
        <pre><code><span data-install-comment data-unix={t.hero.termComment1} data-win={t.hero.termComment1Win}>{t.hero.termComment1}</span>
<span data-install-prompt>$</span> <span data-install-cmd data-unix="curl -fsSL https://www.soulink.cam/install.sh | sh" data-win="irm https://www.soulink.cam/install.ps1 | iex">curl -fsSL https://www.soulink.cam/install.sh | sh</span>

{t.hero.termComment2}
$ soulink 3000
<span class="ok">→ https://fresh-otter-42.apps.soulink.cam</span></code></pre>
      </div>
      <p class="term-note">{t.hero.termNote}</p>
    </div>
  </section>

  <section id="features" class="section">
    <div class="container">
      <h2>{t.features.title}</h2>
      <div class="grid">
        {t.features.items.map((f) => (
          <div class="card">
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="quickstart" class="section">
    <div class="container narrow">
      <h2>{t.quickstart.title}</h2>

      <h3>{t.quickstart.s1t}</h3>
      <p>{t.quickstart.s1d}</p>
      <div class="os-tabs">
        <button class="os-tab" data-os="macos" type="button">macOS</button>
        <button class="os-tab" data-os="linux" type="button">Linux</button>
        <button class="os-tab" data-os="windows" type="button">Windows</button>
      </div>
      <div class="os-panel" data-os-panel="macos">
        <pre class="code"><code>curl -fsSL https://www.soulink.cam/install.sh | sh</code></pre>
        <p class="muted small mirror-hint">{t.quickstart.s1note} <code>SOULINK_GITHUB_MIRROR=gh-proxy.com</code></p>
      </div>
      <div class="os-panel" data-os-panel="linux">
        <pre class="code"><code>curl -fsSL https://www.soulink.cam/install.sh | sh</code></pre>
        <p class="muted small mirror-hint">{t.quickstart.s1note} <code>SOULINK_GITHUB_MIRROR=gh-proxy.com</code></p>
      </div>
      <div class="os-panel" data-os-panel="windows">
        <pre class="code"><code>irm https://www.soulink.cam/install.ps1 | iex</code></pre>
        <p class="muted small mirror-hint">{t.quickstart.s1note} <code>$env:SOULINK_GITHUB_MIRROR='gh-proxy.com'</code></p>
        <p class="muted">{t.quickstart.winZip}</p>
      </div>

      <h3>{t.quickstart.s2t}</h3>
      <p>{t.quickstart.s2d}</p>
      <pre class="code"><code>soulink 3000
<span class="ok">→ https://fresh-otter-42.apps.soulink.cam</span></code></pre>

      <h3>{t.quickstart.s3t}</h3>
      <p class="muted">{t.quickstart.s3d}</p>
      <pre class="code"><code>soulink config set server https://hub.soulink.cam
soulink config set token &lt;token&gt;
soulink 3000 --subdomain myapp</code></pre>
    </div>
  </section>

  <section id="tiers" class="section">
    <div class="container">
      <h2>{t.tiers.title}</h2>
      <p class="muted">{t.tiers.desc}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>{t.tiers.cols.map((c) => <th>{c}</th>)}</tr>
          </thead>
          <tbody>
            {t.tiers.rows.map((r) => (
              <tr>{r.map((cell) => <td>{cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small">{t.tiers.note}</p>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container footer-inner">
    <p>{t.footer.tagline}</p>
    <nav>
      <a href="https://github.com/soulink9/soulink" target="_blank" rel="noopener">{t.footer.github}</a>
      <a href="https://github.com/soulink9/soulink/releases" target="_blank" rel="noopener">{t.footer.releases}</a>
      <a href="https://hub.soulink.cam" target="_blank" rel="noopener">{t.footer.console}</a>
      <a href="https://github.com/soulink9/soulink/blob/main/LICENSE" target="_blank" rel="noopener">{t.footer.license}</a>
    </nav>
    <p class="muted small">© 2026 soulink</p>
  </div>
</footer>

<script is:inline>
  (function () {
    var ua = navigator.userAgent || '';
    var os = /Windows/i.test(ua) ? 'windows' : /Android|Linux/i.test(ua) ? 'linux' : 'macos';

    // hero 与快速上手两处选项卡共享同一份 OS 选择状态
    var tabs = document.querySelectorAll('.os-tab');
    var panels = document.querySelectorAll('.os-panel');
    var comment = document.querySelector('[data-install-comment]');
    var prompt = document.querySelector('[data-install-prompt]');
    var cmd = document.querySelector('[data-install-cmd]');

    function select(name) {
      tabs.forEach(function (b) { b.classList.toggle('active', b.dataset.os === name); });
      panels.forEach(function (p) { p.hidden = p.dataset.osPanel !== name; });
      if (comment && prompt && cmd) {
        var win = name === 'windows';
        comment.textContent = comment.getAttribute(win ? 'data-win' : 'data-unix');
        prompt.textContent = win ? 'PS>' : '$';
        cmd.textContent = cmd.getAttribute(win ? 'data-win' : 'data-unix');
      }
    }
    tabs.forEach(function (b) { b.addEventListener('click', function () { select(b.dataset.os); }); });
    select(os);

    // 主题切换：缺省跟随系统，点击后在 localStorage 持久化显式选择
    var root = document.documentElement;
    var toggle = document.querySelector('[data-theme-toggle]');
    if (toggle) {
      toggle.addEventListener('click', function () {
        var current = root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        var next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('soulink-theme', next); } catch (e) {}
      });
    }
  })();
</script>
